# Copy to .env.local (gitignored) and fill in real values there.
# See docs/adr/ADR-009-deployment-environments-secrets.md.
#
# Everything below is server-only. A variable only reaches the browser
# bundle if it's prefixed NEXT_PUBLIC_ — nothing here should ever be.

# Phase 3 — admin/owner connection, used by drizzle-kit migrate and the
# seed script only. This role is a local superuser (BYPASSRLS) — never use
# it for application queries. Run scripts/db-bootstrap.sh first.
DATABASE_URL=

# Phase 3 — application connection. A non-superuser role with no
# BYPASSRLS, so row-level security policies actually apply. The Postgres
# repository adapter and the isolation test both use this one. See
# docs/adr/ADR-004-row-level-security.md.
DATABASE_URL_APP=

# Supabase database hosting: use the dashboard's session-pooler URL (5432)
# for DATABASE_URL. db:supabase:setup provisions a restricted role and
# writes DATABASE_URL_APP automatically. See docs/SUPABASE.md.
# Keep the original local URLs here so db:test always stays local.
LOCAL_DATABASE_URL=
LOCAL_DATABASE_URL_APP=

# Hosted only (e.g. Vercel), where no certificate file exists: the
# Supabase root CA as PEM text (literal \n escapes are fine). Replaces any
# sslmode/sslrootcert in the URLs above and verifies the hostname.
DATABASE_CA_CERT=
# Connections per server instance. Keep small on serverless (e.g. 3).
DATABASE_POOL_MAX=

# Phase 5 — Anthropic Claude for Brain Dump extraction (PRD §2.7.2,
# docs/adr/ADR-011-claude-extraction.md). Optional: without it, capture uses
# TaskMaster's built-in rules and says so. The SDK also accepts
# ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile instead.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# Kill switch: "off" stops all Claude calls; capture keeps working.
AI_EXTRACTION=
# Claude calls per account per hour: Free (default 30) and Pro (default 120).
AI_HOURLY_LIMIT=
AI_HOURLY_LIMIT_PRO=

# Sign-in: Supabase Auth (docs/adr/ADR-013-supabase-auth.md).
# Local: `npm run supabase:start` prints these (API URL, Publishable key,
# Secret key). Hosted: Supabase dashboard → Project Settings → API Keys.
# Google, email templates and custom SMTP (Resend) are configured in the
# Supabase dashboard (docs/OPERATIONS.md), not here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (admin API: account deletion, demo seed, account migration).
SUPABASE_SECRET_KEY=

# Calendar feeds (docs/OPERATIONS.md): encrypts saved private iCal
# addresses. Optional; defaults to a key derived from SUPABASE_SECRET_KEY.
CALENDAR_ENCRYPTION_KEY=

# Billing (docs/OPERATIONS.md › Billing). Off until both of the first two
# are set; until then every account gets Pro limits.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
# Shown on /pricing, e.g. "£4 / month".
PRO_PRICE_LABEL=
