<?xml version="1.0" encoding="utf-8"?>
<!-- "Today's tasks" widget, 4x3 (NextActionWidget.kt). RemoteViews-safe
     classes only: LinearLayout, FrameLayout, TextView, ImageView, ProgressBar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="TaskMaster"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ai"
            android:textColor="@color/widget_ring"
            android:textSize="16sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/widget_add"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_plus"
            android:contentDescription="Capture">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_plus" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Today"
            android:textColor="@color/widget_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/d0"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/widget_divider" />

    <LinearLayout
        android:id="@+id/t0_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/t0_bar"
            android:layout_width="3dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_bar"
            android:visibility="visible" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="9dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_ring" />

        <TextView
            android:id="@+id/t0_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/t0_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/d1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/widget_divider" />

    <LinearLayout
        android:id="@+id/t1_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/t1_bar"
            android:layout_width="3dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_bar"
            android:visibility="invisible" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="9dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_ring" />

        <TextView
            android:id="@+id/t1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/t1_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/d2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/widget_divider" />

    <LinearLayout
        android:id="@+id/t2_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/t2_bar"
            android:layout_width="3dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_bar"
            android:visibility="invisible" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="9dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_ring" />

        <TextView
            android:id="@+id/t2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/t2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:gravity="center_vertical"
        android:text="Plan your day with a Brain Dump"
        android:textColor="@color/widget_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/d3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/widget_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_muted"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_sage" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_calendar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/widget_icon_tile">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_calendar" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
