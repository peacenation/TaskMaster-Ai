# Copy to .env.local (gitignored) and fill in real values there.
# See docs/adr/ADR-009-deployment-environments-secrets.md.
#
# Everything below is server-only. None of these are read anywhere yet —
# DATABASE_URL arrives with Phase 3, AI_PROVIDER_API_KEY with Phase 5/6.
# A variable only reaches the browser bundle if it's prefixed
# NEXT_PUBLIC_ — nothing here should ever be.

# Phase 3 — Postgres connection string (local Homebrew install for now)
DATABASE_URL=

# Phase 5/6 — AI provider (OpenAI-compatible), see docs/adr/ADR-006-ai-integration.md
AI_PROVIDER_API_KEY=
