# Copy to .env.local (gitignored) and fill in real values there.
# See docs/adr/ADR-009-deployment-environments-secrets.md.
#
# Everything below is server-only. A variable only reaches the browser
# bundle if it's prefixed NEXT_PUBLIC_ — nothing here should ever be.

# Phase 3 — admin/owner connection, used by drizzle-kit migrate and the
# seed script only. This role is a local superuser (BYPASSRLS) — never use
# it for application queries. Run scripts/db-bootstrap.sh first.
DATABASE_URL=

# Phase 3 — application connection. A non-superuser role with no
# BYPASSRLS, so row-level security policies actually apply. The Postgres
# repository adapter and the isolation test both use this one. See
# docs/adr/ADR-004-row-level-security.md.
DATABASE_URL_APP=

# Phase 5/6 — AI provider (OpenAI-compatible), see docs/adr/ADR-006-ai-integration.md
AI_PROVIDER_API_KEY=
